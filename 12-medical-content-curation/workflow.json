    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\n\nconst rawResponse = item.output || item.message?.content || item.text || item.response || '';\n\nlet parsed = {};\ntry {\n  const clean = rawResponse.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(clean);\n} catch(e) {\n  parsed = {\n    titulo_pt: 'Sem título',\n    resumo: '',\n    relevancia: 'media',\n    motivo_relevancia: 'Erro ao classificar',\n    tipo_conteudo: 'notícia',\n    usar_como_post: false\n  };\n}\n\n// Busca os campos originais no nó Preparar Campos\nconst original = $('Preparar Campos').item.json;\n\nreturn {\n  json: {\n    ...parsed,\n    titulo_original: original.titulo_original,\n    url: original.url,\n    fonte: original.fonte,\n    data_coleta: original.data_coleta,\n    especialidade: original.especialidade\n  }\n};"
      },
